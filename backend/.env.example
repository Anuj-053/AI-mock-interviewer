# -----------------------------------------------------------
# Rename this file to ".env" and fill in your real values.
# Never commit your real .env file to GitHub!
# -----------------------------------------------------------

# Port the Express server will run on (Render automatically provides PORT in production)
PORT=5000

# MongoDB connection string (local or MongoDB Atlas connection URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai-resume-interviewer?retryWrites=true&w=majority

# Secret key used to sign JWT tokens - use any long random string
JWT_SECRET=change_this_to_a_long_random_secret_string

# Google Gemini API key (primary question generator)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# xAI Grok API key (automatic fallback if Google Gemini fails or is throttled)
# Get one at https://console.x.ai/
GROK_API_KEY=your_grok_api_key_here

# Pinecone Vector Database configuration (recommended for cloud deployment on Render/Vercel)
# Sign up at https://www.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=resume-index

# ChromaDB server URL (optional, if running ChromaDB locally instead of Pinecone)
CHROMA_URL=http://localhost:8000
