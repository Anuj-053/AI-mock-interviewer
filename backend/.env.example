# -----------------------------------------------------------
# Rename this file to ".env" and fill in your real values.
# Never commit your real .env file to GitHub!
# -----------------------------------------------------------

# Port the Express server will run on
PORT=5000

# MongoDB connection string (local or MongoDB Atlas free tier)
MONGO_URI=mongodb://127.0.0.1:27017/ai-resume-interviewer

# Secret key used to sign JWT tokens - use any long random string
JWT_SECRET=change_this_to_a_long_random_secret_string

# Google Gemini API key (used for BOTH embeddings and question/answer generation)
# Get one for free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ChromaDB server URL (we run Chroma locally, see README for setup)
CHROMA_URL=http://localhost:8000
